# Application
APP_NAME=AI-Powered Competency Learning Platform
APP_ENV=development
DEBUG=False
SECRET_KEY=replace_with_a_long_random_secret
SESSION_MAX_AGE_HOURS=12

# MongoDB local example. For Atlas, use the URI supplied by Atlas.
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=competency_learning_db
SEED_ON_START=False

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
MAX_AI_PROMPT_CHARS=30000
MAX_AI_OUTPUT_CHARS=20000
